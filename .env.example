# =========================================================
# LAN Atlas - example environment file
# Copy this file to .env for local development
# Do not put real secrets / API KEYS in this file
# =========================================================

# Note:
# CTRL+F "super-linter-fix:" for Nick's super-linter patches

# App environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# App server
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me

# Database
DATABASE_URL=sqlite:///./lan_atlas.db

# Agent / API auth
AGENT_SHARED_SECRET=change-me
API_TOKEN_EXPIRY_HOURS=24

# AWS
AWS_ACCESS_KEY_ID=
AWS_DYNAMODB_TABLE=lan-atlas
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_SECRET_ACCESS_KEY=

# Alerts / email
ALERT_FROM_EMAIL=alerts@example.com
SMTP_HOST=localhost
SMTP_PASSWORD=
SMTP_PORT=1025
SMTP_USER=

# Scanning defaults
DEFAULT_SCAN_SUBNET=192.168.1.0/24
SCAN_MAX_HOSTS=1024
SCAN_TIMEOUT_SECONDS=2

# Dashboard / frontend
DASHBOARD_ORIGIN=http://localhost:3000

# NOTES FOR CONTRIBUTORS

# Required for local app startup
# super-linter-fix: Commented out SECRET_KEY due to duplicate vars
# SECRET_KEY=change-me

# Optional unless testing email alerts 
# super-linter-fix: Commented out SMTP_USER and SMTP_PASSWORD due to duplicate vars
# SMTP_USER=
# SMTP_PASSWORD=
